diff --git a/tests/ofxr_bridge_adaptive.ini b/tests/ofxr_bridge_adaptive.ini
--- a/tests/ofxr_bridge_adaptive.ini
+++ b/tests/ofxr_bridge_adaptive.ini
@@ -1,9 +1,4 @@
 [ofxr]
-; DCS Control (port to 0.2.13.2): two swapchains per output. With the single-
-; swapchain rings (V410) a GPU over two periods in 3X finds its history slot
-; busy at almost every capture and generation resets each frame, upstream as
-; well; this test is about adaptive control, not the rings.
-single_swapchain_rings=0
 enabled=1
 frame_generation=ofxr
 motion_vectors=off
