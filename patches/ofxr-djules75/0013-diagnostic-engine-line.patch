+// DCS Control (0013): what DcsQvCull.dll's DcsQvCull_Status() export reports
+// (the engine optimizations inside DCS). Bit 0 running, bit 1 optimizations
+// on (not switched off in flight), bit 2 something turned itself off this
+// session, bits 8-15 optimizations active, bits 16-23 turned off by
+// themselves. known is false when the module or its export is absent.
+struct EngineStatus {
+    bool known{};
+    std::uint64_t bits{};
+};
+inline constexpr std::uint64_t kEngineRunning = 1ULL << 0;
+inline constexpr std::uint64_t kEngineOn = 1ULL << 1;
+inline constexpr std::uint64_t kEngineLatched = 1ULL << 2;
+
 struct DiagnosticInputs {
     float output_fps{};        // what the overlay's counter shows
