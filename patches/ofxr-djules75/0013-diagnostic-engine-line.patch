     // DCS VR Control (0007): `[ofxr] diag_vram`.
     bool show_vram{};
     VramStatus vram;
+    // DCS Control (0013): the engine optimizations and their in-flight switch.
+    EngineStatus engine;
+    DiagnosticHotkey engine_hotkey;
 };
 
 [[nodiscard]] std::string format_dlss_line(const DiagnosticInputs& inputs, DiagnosticColor& color);
 [[nodiscard]] std::string format_generation_line(const DiagnosticInputs& inputs, DiagnosticColor& color);
+// DCS Control (0013): "Engine: ON (13)" green, "Engine: ON, 1 turned off"
+// amber, "Engine: OFF (Alt+Shift+F11)" grey, "Engine: starting" grey. Empty
+// when the module is not loaded (the line is then left out).
+[[nodiscard]] std::string format_engine_line(const DiagnosticInputs& inputs, DiagnosticColor& color);
 // DCS VR Control (0007): "VRAM 28.4 / 32.0 GB" - what every process has
