+    void read_engine(DiagnosticInputs& inputs) {
+        inputs.engine_hotkey = engine_hotkey;
+        if (!engine_status) {
+            const auto tick = GetTickCount64();
+            if (tick < next_engine_lookup_ms) return;
+            next_engine_lookup_ms = tick + 2000;
+            if (HMODULE module = GetModuleHandleW(L"DcsQvCull.dll"))
+                engine_status = reinterpret_cast<EngineStatusFn>(GetProcAddress(module, "DcsQvCull_Status"));
+            if (!engine_status) return;
+        }
+        inputs.engine = {true, engine_status()};
+    }
