+HRESULT D3D12FrameSynthesizer::wait_for_fence(
+    ID3D12Fence* fence, std::uint64_t value) noexcept {
+    try {
+        std::scoped_lock lock(mutex_);
+        if (impl_ == nullptr || fence == nullptr) {
+            return E_INVALIDARG;
+        }
+        if (impl_->queue == nullptr) {
+            return E_UNEXPECTED;
+        }
+        const std::uint64_t completed = fence->GetCompletedValue();
+        // UINT64_MAX is a removed device: waiting on it would never resolve.
+        if (completed == std::numeric_limits<std::uint64_t>::max() ||
+            completed >= value) {
+            return S_FALSE;
+        }
+        return impl_->queue->Wait(fence, value);
+    } catch (...) {
+        return E_FAIL;
+    }
+}
