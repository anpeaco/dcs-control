diff --git a/src/layer/openxr_layer.cpp b/src/layer/openxr_layer.cpp
--- a/src/layer/openxr_layer.cpp
+++ b/src/layer/openxr_layer.cpp
@@ -6128,6 +6128,19 @@ XrResult layer_create_session_impl(
             binding_queue_description.Type = D3D12_COMMAND_LIST_TYPE_DIRECT;
             binding_queue_description.NodeMask =
                 state->d3d12_queue->GetDesc().NodeMask;
+            // DCS Control (0024): the runtime judges a frame complete by this
+            // queue's progress. At NORMAL priority beside the HIGH bridge and
+            // synthesis queues, Virtual Desktop's passed each generated
+            // frame's hand-over a median 14.8 ms late in a DCS flight (more
+            // than a 72 Hz period for 58% of them) although synthesis had
+            // finished ~19 ms earlier. Its work is copies, joins and the
+            // runtime's own waits: small, and wanted ahead of the game's.
+            // Capability bit 512.
+            const bool binding_queue_high = xrfg::implicit_layer::
+                read_binding_queue_high_priority(current_layer_directory());
+            if (binding_queue_high) {
+                binding_queue_description.Priority = D3D12_COMMAND_QUEUE_PRIORITY_HIGH;
+            }
             Microsoft::WRL::ComPtr<ID3D12CommandQueue> binding_queue;
             Microsoft::WRL::ComPtr<ID3D12Fence> release_fence;
             Microsoft::WRL::ComPtr<ID3D12Fence> reacquire_fence;
@@ -6150,6 +6163,9 @@ XrResult layer_create_session_impl(
                 state->app_release_fence = std::move(release_fence);
                 state->reacquire_fence = std::move(reacquire_fence);
                 state->graphics_binding_capabilities |= 16ULL;
+                if (binding_queue_high) {
+                    state->graphics_binding_capabilities |= 512ULL; // 0024
+                }
             }
         }
     }
