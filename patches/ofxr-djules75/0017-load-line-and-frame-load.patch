+void LoadWindow::add(std::int64_t at, std::int64_t cpu, std::int64_t gpu) noexcept {
+    if (start_ < 0) start_ = at;
+    if (count_ < cpu_.size()) cpu_[count_++] = std::max<std::int64_t>(0, cpu);
+    if (gpu >= 0) { gpu_sum_ += gpu; ++gpu_count_; }
+}
+
+bool LoadWindow::take(std::int64_t at, std::int64_t slot, LoadStatus& out) noexcept {
+    constexpr std::int64_t kSecondNs = 1'000'000'000;
+    if (start_ < 0 || count_ == 0 || at - start_ < kSecondNs) return false;
+    // The 90th percentile as the app's Last flight page takes it: the
+    // ceil(0.9 n)-th smallest.
+    const std::size_t k = (count_ * 9 + 9) / 10 - 1;
+    std::nth_element(cpu_.begin(), cpu_.begin() + static_cast<std::ptrdiff_t>(k),
+        cpu_.begin() + static_cast<std::ptrdiff_t>(count_));
+    out.known = true;
+    out.cpu_ms = static_cast<float>(static_cast<double>(cpu_[k]) / 1e6);
+    out.gpu_ms = gpu_count_ ? static_cast<float>(static_cast<double>(gpu_sum_) / static_cast<double>(gpu_count_) / 1e6) : -1.0f;
+    out.slot_ms = slot > 0 ? static_cast<float>(static_cast<double>(slot) / 1e6) : 0.0f;
+    reset();
+    start_ = at;
+    return true;
+}
+
+std::string format_load_line(const LoadStatus& load, DiagnosticColor& color) {
+    const bool gpu_known = load.gpu_ms >= 0.0f;
+    std::string text = "CPU " + fixed(load.cpu_ms, 1) + "  GPU " + (gpu_known ? fixed(load.gpu_ms, 1) : std::string("--"));
+    if (load.slot_ms <= 0.0f) { color = DiagnosticColor::white; return text + " ms"; }
+    text += "  of " + fixed(load.slot_ms, 1) + " ms";
+    const float limit = 0.85f * load.slot_ms;
+    const float worst = std::max(load.cpu_ms, gpu_known ? load.gpu_ms : 0.0f);
+    if (worst < limit) { color = DiagnosticColor::green; return text; }
+    color = worst > load.slot_ms ? DiagnosticColor::red : DiagnosticColor::amber;
+    // The GPU's busy time is measured directly; the CPU time also grows when
+    // the driver holds DCS for the GPU, so the GPU decides first.
+    return text + (gpu_known && load.gpu_ms >= limit ? "  GPU-bound" : "  CPU-bound");
+}
